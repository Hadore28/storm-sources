.classList.add('premium-content');\n    \n                content.innerHTML = `\n                    <svg viewBox=\"0 0 24 24\" stroke=\"currentColor\" style=\"height: 4rem;width: 4rem;color: rgb(254 202 202)\" fill=\"none\" stroke-width=\"1.5\">\n                        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z\"></path>\n                    </svg>\n                    <h3 style=\"margin: 0;\">عذراً، هذه الجودة حصرية للمشتركين في العضوية المميزة.</h3>\n                    <p style=\"margin: 0;\">بدّل لجودة أخرى أو اشترك الآن للاستمتاع بإمكانية مشاهدة الفيديوهات بجودة عالية مع حجم أقل!</p>\n                `;\n    \n                var modal = player.addChild('ModalDialog', {content: content, temporary: true});\n                \n                modal.open();\n\n                var previousSrc = video_sources.find(video => video.src == player.src());\n\n                player.currentResolution(previousSrc ? previousSrc.label : 'low');\n            } else {\n                player.src(source);\n            }\n\n            return player;\n        }\n    });\n\n    this.updateSrc(video_sources);\n\nplayer.on('error', function (){\n    if(video_sources.length <= 1) return;\n    let resolutions = '';\n    video_sources.forEach(element => {\n        resolutions += '<button onclick=\"player.currentResolution(\\''+element['label']+'\\'); this.parentNode.parentNode.remove()\">'+ element['label'] +'</button>';\n    });\n    document.querySelector('.vjs-error-display .vjs-modal-dialog-content').innerHTML = `\n        <div style=\"padding: 15px;\">${document.querySelector('.vjs-error-display .vjs-modal-dialog-content').innerHTML}</div>\n        <div class=\"resolution-box\">\n            <p>قد تكون المشكلة في جودة معينة، جرّب غيرها.</p>\n\n            <div>\n                ${resolutions}\n            </div>\n        </div>\n    `;\n});\n\nthis.on('resolutionchange', function(){\n    video_sources.forEach(video => {\n        if(video.src.includes(player.src()))  {\n            let preferredQuality = [];\n\n            try {\n                preferredQuality = JSON.parse(localStorage.getItem('preferredQuality')) || [];\n            } catch (e) {}\n            \n            preferredQuality = preferredQuality.filter((q) => q !== video.res);\n            preferredQuality.unshift(video.res);\n\n            localStorage.setItem('preferredQuality', JSON.stringify(preferredQuality));\n        }\n    });\n})    \n    this.hotkeys({\n    volumeStep: 0.1, \n    seekStep: 5, \n    enableModifiersForNumbers: false,\n    enableVolumeScroll: false\n});    \n    this.mobileUi({\n    fullscreen: {\n        enterOnRotate: true,\n        exitOnRotate: true,\n        lockOnRotate: true\n    },\n    touchControls: {\n        seekSeconds: 10,\n        tapTimeout: 300,\n        disableOnEnd: false\n    }\n});    \n        \n        \n    this.vttThumbnails({\n        src: 'https://thumbnails.vid3rb.com/files/0020250264/9d494e59-3d78-4b23-8258-29ad0824e4ef/thumbnails.vtt'\n    });\n\n    player.on('touchstart', function(e) { \n        thumbnails = document.querySelector('.vjs-vtt-thumbnail-display');\n    \n        if (window.getComputedStyle(thumbnails).opacity !== '0') {\n            this.vttThumbnails.hideThumbnailHolder()\n        }\n    });\n    \n    this.landscapeFullscreen({\n    fullscreen: {\n        enterOnRotate: true,\n        exitOnRotate: true,\n        alwaysInLandscapeMode: true,\n        iOS: false\n    }\n});});            \n                        \n                        \n                    });\n    </script>\n\n    </body>\n</html>\n    \n    "}